{
  "name": "webaseui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace @webaseui/svelte",
    "build:docs": "npm run build && npm run build --workspace @webaseui/docs",
    "typecheck": "npm run typecheck --workspace @webaseui/svelte && npm run build && npm run typecheck:browser && npm run typecheck:ssr && npm run typecheck --workspace @webaseui/docs",
    "typecheck:browser": "svelte-check --workspace tests/browser --tsconfig ./tsconfig.json",
    "typecheck:ssr": "svelte-check --workspace tests/ssr --tsconfig ./tsconfig.json",
    "check": "npm run test:unit && npm run typecheck && npm run build:docs && node scripts/check-webaseui-packages.mjs && npm run check:api-contract && npm run check:support && npm run check:tokens && npm run check:contrast && npm run check:docs-design && npm run check:visual-baselines && npm run check:size",
    "check:api-contract": "node scripts/check-api-contract.mjs",
    "check:changeset": "node scripts/check-changeset.mjs",
    "check:contrast": "node scripts/check-token-contrast.mjs",
    "check:consumer": "npm run build && node scripts/test-webaseui-consumer.mjs",
    "check:docs-design": "node scripts/check-docs-design.mjs",
    "check:size": "node scripts/check-package-size.mjs",
    "check:support": "node scripts/check-support-policy.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:visual-baselines": "node scripts/check-visual-baselines.mjs",
    "test:browser": "npm run build:docs && playwright test --project=chromium --project=firefox --project=webkit",
    "test:browser:project": "npm run build:docs && playwright test",
    "test:visual": "npm run build:docs && playwright test --project=visual-chromium",
    "test:visual:update": "npm run build:docs && playwright test --project=visual-chromium --update-snapshots",
    "size:update": "node scripts/check-package-size.mjs --write",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "deploy:docs": "node scripts/deploy-docs.mjs",
    "deploy:docs:preview": "node scripts/deploy-docs.mjs --preview",
    "check:registry": "node scripts/registry-smoke.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "release:ci": "changeset publish",
    "release": "npm run check && npm run check:consumer && npm run test:browser && npm run test:visual && npm run release:ci",
    "release:next": "node scripts/release-channel.mjs next",
    "release:canary": "node scripts/release-channel.mjs canary"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "svelte": "^5.56.8",
    "svelte-check": "4.7.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "postcss": "8.5.25",
    "undici": "7.29.0"
  },
  "license": "MIT"
}
