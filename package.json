{
  "name": "xueui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build --workspace @xueui/svelte",
    "check": "npm run build && node scripts/check-xueui-packages.mjs",
    "check:consumer": "npm run build && node scripts/test-xueui-consumer.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run check && npm run check:consumer && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte": "^5.56.8",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "postcss": "8.5.25"
  },
  "license": "MIT"
}
